{
  "policy_version": 1,
  "offline_required": true,
  "acquisition_on_creation_device": false,
  "install_from_local_wheels_only": true,
  "verify_artifact_hashes": true,
  "require_pinned_dependencies": true,
  "allow_remote_dependency_references": false,
  "allow_runtime_downloads": false,
  "allow_remote_model_code": false,
  "allow_cloud_inference": false,
  "allow_telemetry": false,
  "allow_crash_uploads": false,
  "allow_update_checks": false,
  "allow_public_share_links": false,
  "allow_external_ui_assets": false,
  "require_verified_network_isolation": true,
  "unsupported_platform_action": "refuse",
  "missing_asset_action": "fail",
  "logs": "local_only",
  "model_root": "models",
  "work_root": "work",
  "output_root": "out",
  "comment": "Enforced by launcher. Acquisition-only machine may temporarily disable, but creation device must never connect."
}
